{
  "outputDirectory": "public",
  "functions": {
    "api/preview.js": {
      "maxDuration": 60
    },
    "api/notify.js": {
      "maxDuration": 20
    },
    "api/cron-digest.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-digest",
      "schedule": "0 0 * * 1-5"
    }
  ]
}